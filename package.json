{
  "name": "qwen-autocomplete-monitor",
  "displayName": "Qwen Autocomplete Monitor",
  "description": "Monitor Continue autocomplete requests routed through a local Ollama reverse proxy, including first-token latency and empty responses.",
  "version": "1.1.0",
  "publisher": "local-tools",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "Qwen Autocomplete Monitor",
      "properties": {
        "continueQwenIndicator.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL of the Ollama server behind the local proxy."
        },
        "continueQwenIndicator.proxyPort": {
          "type": "number",
          "default": 11435,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Local port Continue should use for Ollama requests."
        },
        "continueQwenIndicator.model": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b-base",
          "description": "Exact Ollama model name to monitor."
        }
      }
    },
    "commands": [
      { "command": "continueQwenIndicator.showStatus", "title": "Qwen Monitor: Show Status" },
      { "command": "continueQwenIndicator.openLogs", "title": "Qwen Monitor: Open Request Logs" },
      { "command": "continueQwenIndicator.restartProxy", "title": "Qwen Monitor: Restart Proxy" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
