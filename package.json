
{
  "name": "continue-qwen-indicator",
  "displayName": "Continue Qwen Activity Indicator",
  "description": "Shows when Continue sends autocomplete requests to a local Ollama Qwen model.",
  "version": "0.1.0",
  "publisher": "local-tools",
  "engines": {
    "vscode": "^1.85.0"
  },

  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
    "repository": {
    "type": "git",
    "url": "https://github.com/drewosmundson/InlineAutocompleateIndicator"
    },
    
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "continueQwenIndicator.showStatus",
        "title": "Qwen Indicator: Show Status"
      },
      {
        "command": "continueQwenIndicator.restartProxy",
        "title": "Qwen Indicator: Restart Proxy"
      }
    ],
    "configuration": {
      "title": "Continue Qwen Activity Indicator",
      "properties": {
        "continueQwenIndicator.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL of your Ollama server."
        },
        "continueQwenIndicator.proxyPort": {
          "type": "number",
          "default": 11435,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Local port used by the proxy."
        },
        "continueQwenIndicator.model": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b-base",
          "description": "Exact Ollama model name to monitor."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.3.3"
  },
    "overrides": {
    "@vscode/vsce": {
        "minimatch": "^11.0.1"
    }
  }
}
